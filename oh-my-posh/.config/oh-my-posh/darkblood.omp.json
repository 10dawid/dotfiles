{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palettes": {
    "template": "{{ if eq .OS \"darwin\" }}mac{{ else }}linux{{ end }}",
    "list": {
      "mac": {
        "accent": "#97EFE9"
      },
      "linux": {
        "accent": "#35FF69"
      }
    }
  },
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "foreground": "#ffffff",
          "style": "plain",
          "template": "<p:accent>\u250f[</>{{ .UserName }}<p:accent>]</>",
          "type": "session"
        },
        {
          "foreground": "#ffffff",
          "style": "plain",
          "template": "<p:accent>[</>{{ .HEAD }}<p:accent>]</>",
          "type": "git"
        },
        {
          "foreground": "#ffffff",
          "style": "plain",
          "template": "<p:accent>[</>\uf0e7<p:accent>]</>",
          "type": "root"
        },
        {
          "foreground": "#ffffff",
          "style": "plain",
          "template": "<p:accent>[x</>{{ reason .Code }}<p:accent>]</>",
          "type": "status"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "#ffffff",
          "properties": {
            "style": "full"
          },
          "style": "plain",
          "template": "<p:accent>\u2516[</>{{ .Path }}<p:accent>]></>",
          "type": "path"
        }
      ],
      "type": "prompt"
    }
  ],
  "final_space": true,
  "version": 3
}
